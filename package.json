{
  "name": "cumsevoteaza",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace @cumsevoteaza/web run dev",
    "build": "npm --workspace @cumsevoteaza/web run build",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && npm run test:python-pipeline",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "npm --workspace @cumsevoteaza/db run generate",
    "db:migrate": "npm --workspace @cumsevoteaza/db run migrate",
    "db:studio": "npm --workspace @cumsevoteaza/db run studio",
    "ingest:senate:bill": "npm --workspace @cumsevoteaza/ingest run senate:bill --",
    "ingest:senate:vote": "npm --workspace @cumsevoteaza/ingest run senate:vote --",
    "ingest:chamber:vote": "npm --workspace @cumsevoteaza/ingest run chamber:vote --",
    "ingest:senate:roster": "npm --workspace @cumsevoteaza/ingest run senate:roster --",
    "ingest:deputies:roster": "npm --workspace @cumsevoteaza/ingest run deputies:roster --",
    "ingest:official-careers": "npm --workspace @cumsevoteaza/ingest run official-careers --",
    "ingest:cdep-history:import": "npm --workspace @cumsevoteaza/ingest run cdep-history:import --",
    "ingest:cdep-history:cleanup": "npm --workspace @cumsevoteaza/ingest run cdep-history:cleanup --",
    "ingest:assets:import": "npm --workspace @cumsevoteaza/ingest run assets:import --",
    "ingest:roster:all": "npm --workspace @cumsevoteaza/ingest run roster:all --",
    "ingest:roster:reset": "npm --workspace @cumsevoteaza/ingest run roster:reset --",
    "ingest:wikipedia:roster": "npm --workspace @cumsevoteaza/ingest run wikipedia:roster --",
    "ingest:wikipedia:roster:all": "npm --workspace @cumsevoteaza/ingest run wikipedia:roster:all --",
    "ingest:wikipedia:roster:import": "npm --workspace @cumsevoteaza/ingest run wikipedia:roster:import --",
    "ingest:wikipedia:roster-index": "npm --workspace @cumsevoteaza/ingest run wikipedia:roster-index --",
    "ingest:roster:crosscheck": "npm --workspace @cumsevoteaza/ingest run roster:crosscheck --",
    "ingest:roster:crosscheck:all": "npm --workspace @cumsevoteaza/ingest run roster:crosscheck:all --",
    "ingest:people:backfill": "npm --workspace @cumsevoteaza/ingest run people:backfill --",
    "ingest:governments:skeleton": "npm --workspace @cumsevoteaza/ingest run governments:skeleton --",
    "ingest:discover:senate": "npm --workspace @cumsevoteaza/ingest run discover:senate --",
    "ingest:discover:deputies": "npm --workspace @cumsevoteaza/ingest run discover:deputies --",
    "ingest:discover:deputies-votes": "npm --workspace @cumsevoteaza/ingest run discover:deputies-votes --",
    "ingest:backfill:2024": "npm --workspace @cumsevoteaza/ingest run backfill:2024 --",
    "ingest:sync:daily": "npm --workspace @cumsevoteaza/ingest run sync:daily --",
    "ingest:import:pending": "npm --workspace @cumsevoteaza/ingest run import:pending --",
    "ingest:audit:current-legislature": "npm --workspace @cumsevoteaza/ingest run audit:current-legislature --",
    "ingest:refresh-read-models": "npm --workspace @cumsevoteaza/ingest run refresh-read-models --",
    "probe:cdep-history": "python3 tools/cdep-history-probe/cdep_history_probe.py",
    "pipeline:parliament": "python3 tools/parliament-pipeline/parliament_pipeline.py",
    "test:python-pipeline": "python3 -m unittest discover -s tools/parliament-pipeline/tests"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
