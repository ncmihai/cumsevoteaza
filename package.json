{
  "name": "cumsevoteaza",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace @cumsevoteaza/web run dev",
    "build": "npm --workspace @cumsevoteaza/web run build",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "npm --workspace @cumsevoteaza/db run generate",
    "db:migrate": "npm --workspace @cumsevoteaza/db run migrate",
    "db:studio": "npm --workspace @cumsevoteaza/db run studio",
    "ingest:senate:bill": "npm --workspace @cumsevoteaza/ingest run senate:bill --",
    "ingest:senate:vote": "npm --workspace @cumsevoteaza/ingest run senate:vote --",
    "ingest:chamber:vote": "npm --workspace @cumsevoteaza/ingest run chamber:vote --",
    "ingest:senate:roster": "npm --workspace @cumsevoteaza/ingest run senate:roster --",
    "ingest:deputies:roster": "npm --workspace @cumsevoteaza/ingest run deputies:roster --",
    "ingest:roster:all": "npm --workspace @cumsevoteaza/ingest run roster:all --",
    "ingest:discover:senate": "npm --workspace @cumsevoteaza/ingest run discover:senate --",
    "ingest:discover:deputies": "npm --workspace @cumsevoteaza/ingest run discover:deputies --",
    "ingest:backfill:2024": "npm --workspace @cumsevoteaza/ingest run backfill:2024 --",
    "ingest:sync:daily": "npm --workspace @cumsevoteaza/ingest run sync:daily --"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
